{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridgehalo.dev/schemas/delivery-manifest.schema.json",
  "title": "DeliveryManifest",
  "type": "object",
  "required": [
    "workItem",
    "baseRevision",
    "headRevision",
    "risk",
    "reviewerCount",
    "gates",
    "testIntent",
    "evidence"
  ],
  "properties": {
    "workItem": {"type": "string", "minLength": 1},
    "baseRevision": {"type": "string", "minLength": 1},
    "headRevision": {"type": "string", "minLength": 1},
    "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "reviewerCount": {"type": "integer"},
    "humanDecision": {
      "type": "string",
      "enum": ["pending", "approved", "rejected"]
    },
    "gates": {
      "type": "object",
      "required": ["plan", "build", "verify", "release"],
      "properties": {
        "plan": {"type": "string", "enum": ["pending", "passed", "blocked"]},
        "build": {"type": "string", "enum": ["pending", "passed", "blocked"]},
        "verify": {"type": "string", "enum": ["pending", "passed", "blocked"]},
        "release": {"type": "string", "enum": ["pending", "passed", "blocked"]}
      },
      "additionalProperties": false
    },
    "testIntent": {
      "type": "object",
      "required": ["core", "shell", "unit", "integration", "e2e", "guards"],
      "properties": {
        "core": {"type": "array", "items": {"type": "string"}},
        "shell": {"type": "array", "items": {"type": "string"}},
        "unit": {"type": "array", "items": {"type": "string"}},
        "integration": {"type": "array", "items": {"type": "string"}},
        "e2e": {"type": "array", "items": {"type": "string"}},
        "guards": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "status", "source"],
        "properties": {
          "type": {"type": "string"},
          "status": {"type": "string", "enum": ["passed", "failed", "unverified"]},
          "source": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
