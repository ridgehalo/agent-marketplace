{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridgehalo.dev/schemas/promotion-bundle.schema.json",
  "title": "PromotionBundle",
  "type": "object",
  "required": [
    "approvalId",
    "approvedAt",
    "targetKind",
    "allowedFields",
    "redactionClass",
    "payload"
  ],
  "properties": {
    "approvalId": {"type": "string", "minLength": 1},
    "approvedAt": {"type": "string", "minLength": 1},
    "targetKind": {"type": "string", "enum": ["issue", "document", "event"]},
    "allowedFields": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "redactionClass": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "personal"]
    },
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
