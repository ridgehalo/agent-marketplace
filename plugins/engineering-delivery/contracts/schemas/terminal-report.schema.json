{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridgehalo.dev/schemas/terminal-report.schema.json",
  "title": "TerminalReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "heading",
    "summary",
    "requiredActions",
    "optionalSuggestions",
    "authorization"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["completed", "stopped", "waiting"]
    },
    "heading": {
      "type": "string",
      "enum": ["## あなたにお願いしたいアクション"]
    },
    "summary": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "requiredActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target", "operation", "reason", "resumeCondition"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["human-gate", "decision", "external-input", "review"]
          },
          "target": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "resumeCondition": {"type": "string", "minLength": 1}
        }
      }
    },
    "optionalSuggestions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "noActionMessage": {
      "type": "string",
      "enum": [
        "ありません。今回の処理は完了です。",
        "ありません。外部状態が変わるまで待機します。"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceStateReadBack",
        "standingAuthorizationValid",
        "operationRequestMatched"
      ],
      "properties": {
        "sourceStateReadBack": {"type": "boolean"},
        "standingAuthorizationValid": {"type": "boolean"},
        "operationRequestMatched": {"type": "boolean"}
      }
    }
  }
}
